# Screen Registry - Source of Truth
# Every reviewable screen in the Resale platform
#
# Naming: screen_id = {flow_id}_step_{n}_{variant}
# For non-step screens: {flow_id}_{screen_name}_{variant}
#
# Figma readiness:
#   - node_id: "TODO_FIGMA_NODE_ID" → unconfigured (auto-skipped)
#   - node_id: "24:45"              → ready (included in default runs)
#   - reviewer_enabled: false        → disabled (always skipped)

screens:

  # ── Auth Flow ──────────────────────────────────────────

  - screen_id: auth_login_default
    flow_id: auth
    step: 1
    variant: default
    route: /login
    preconditions:
      auth: false
    setup:
      strategy: direct
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: ""
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [auth, form, mvp]
    notes: "Centered login form. Error state shows inline red text — separate variant below."
    unconfigured_reason: null

  - screen_id: auth_login_error
    flow_id: auth
    step: 1
    variant: error
    route: /login
    preconditions:
      auth: false
      trigger: "submit with invalid credentials"
    setup:
      strategy: action_sequence
      actions:
        - { action: fill, selector: 'input[name="email"]', value: "bad@example.com" }
        - { action: fill, selector: 'input[name="password"]', value: "wrongpassword" }
        - { action: click, selector: 'button[type="submit"]' }
        - { action: wait, selector: '[data-testid="login-error"]', timeout: 5000 }
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [auth, form, error-state, mvp]
    notes: "Login form showing error message after failed submit."
    unconfigured_reason: "No auth screens exist in Figma file — not yet designed"

  - screen_id: auth_register_default
    flow_id: auth
    step: 2
    variant: default
    route: /register
    preconditions:
      auth: false
    setup:
      strategy: direct
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "174:1539"
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [auth, form, mvp]
    notes: "Centered registration form with name/email/password fields."
    unconfigured_reason: null

  # ── Dashboard Flow ─────────────────────────────────────

  - screen_id: dashboard_home_empty
    flow_id: dashboard
    step: 1
    variant: empty
    route: /dashboard
    preconditions:
      auth: true
      data: "user has zero shops"
    setup:
      strategy: direct
      user_type: empty
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [dashboard, empty-state, mvp]
    notes: "Empty dashboard with 'Create a ReSale shop' CTA. Sidebar visible."
    unconfigured_reason: "Only populated dashboard variant exists in Figma (node 24:45) — no empty state designed"

  - screen_id: dashboard_home_populated
    reviewer_enabled: false
    flow_id: dashboard
    step: 1
    variant: populated
    route: /dashboard
    preconditions:
      auth: true
      data: "user has 1+ shops"
    setup:
      strategy: direct
      user_type: main
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "24:45"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='shop-list']"
        reason: "Shop names/URLs are dynamic seeded data"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.92
    tags: [dashboard, populated, mvp]
    notes: "Dashboard with Orders/Revenue cards and My Shops list. Sidebar shows shop nav items."

  # ── Shop Creation Flow ─────────────────────────────────

  - screen_id: shop_create_step_1_default
    flow_id: shop_create
    step: 1
    variant: default
    route: /shops/create
    preconditions:
      auth: true
    setup:
      strategy: direct
      user_type: main
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "52:1281"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='app-sidebar']"
        reason: "Sidebar shop list and brand name differ between Figma seed data and runtime seed data"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.95
    tags: [wizard, step-1, form, mvp]
    notes: "Brand name + website URL inputs. Stepper shows 1/2. Cancel goes to dashboard. Sidebar masked: Figma has different seed shops than runtime."

  - screen_id: shop_create_step_2_analyzing
    flow_id: shop_create
    step: 2
    variant: default
    route: /shops/create/analyzing
    preconditions:
      auth: true
      data: "shop created, analysis job running"
    setup:
      strategy: wizard_inject
      user_type: main
      query_params:
        _shopId: "{analyzingShopId}"
      wait_for: '[data-testid="progress-loader"]'
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "87:1109"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='app-sidebar']"
        reason: "Sidebar shop list differs between Figma and runtime seed data"
      - selector: "[data-testid='progress-loader']"
        reason: "animate-pulse + dynamic step labels change over time"
    thresholds:
      pixel_diff_percent: 2.0
      structural_similarity: 0.90
    tags: [wizard, step-2, progress, flaky-risk, mvp]
    notes: >
      ProgressLoader with animate-pulse animation. Polls /analysis every 2s.
      In snapshot mode: polling disabled, auto-redirect disabled.
      Requires _shopId query param to hydrate wizard store.

  - screen_id: shop_create_step_3_theme
    flow_id: shop_create
    step: 3
    variant: default
    route: /shops/create/theme
    preconditions:
      auth: true
      data: "shopId in wizard store, analysis complete, themes seeded"
    setup:
      strategy: wizard_inject
      user_type: main
      query_params:
        _shopId: "{shopId}"
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "79:3271"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='app-sidebar']"
        reason: "Sidebar shop list differs between Figma and runtime seed data"
      - selector: "[data-testid='theme-preview-image']"
        reason: "Theme preview images may differ between environments"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.93
    tags: [wizard, step-3, themes, mvp]
    drift_classification: real_drift
    notes: >
      Theme selection grid. Stepper shows 2/2. Mobile/Desktop tab toggle at bottom.
      KNOWN DRIFT: Figma shows Mobile preview mode with phone mockup layout.
      Runtime shows flat list with small thumbnails (Desktop mode).
      This is real design drift, not noise — implementation does not match Figma yet.

  - screen_id: shop_create_step_3_theme_selected
    flow_id: shop_create
    step: 3
    variant: selected
    route: /shops/create/theme
    preconditions:
      auth: true
      data: "shopId in wizard store, themes seeded, one theme clicked"
    setup:
      strategy: action_sequence
      user_type: main
      query_params:
        _shopId: "{shopId}"
      actions:
        - { action: click, selector: '[data-testid="theme-card-core-resale"] button' }
        - { action: wait, timeout: 300 }
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "79:3271"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='app-sidebar']"
        reason: "Sidebar shop list differs between Figma and runtime seed data"
      - selector: "[data-testid='theme-preview-image']"
        reason: "Theme preview images may differ between environments"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.93
    tags: [wizard, step-3, themes, selected, mvp]
    drift_classification: real_drift
    notes: >
      Theme selection with one theme highlighted + Continue button visible.
      KNOWN DRIFT: Same layout mismatch as step_3_theme — Figma shows phone mockup, runtime shows flat list.

  - screen_id: shop_create_step_4_setup
    flow_id: shop_create
    step: 4
    variant: default
    route: /shops/create/setup
    preconditions:
      auth: true
      data: "shopId in wizard store, theme selected"
    setup:
      strategy: wizard_inject
      user_type: main
      query_params:
        _shopId: "{shopId}"
        _themeId: "core-resale"
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "107:1445"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='app-sidebar']"
        reason: "Sidebar shop list differs between Figma and runtime seed data"
      - selector: "[data-testid='logo-uploader']"
        reason: "File uploader preview depends on uploaded file"
      - selector: "input[type='color']"
        reason: "Native color picker renders differently across OS/browsers"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.93
    tags: [wizard, step-4, setup, form, mvp]
    drift_classification: real_drift
    notes: >
      Logo upload, font inputs, color pickers. Stepper shows 1/2 (re-used).
      KNOWN DRIFT: Figma shows 3-column layout with live phone preview.
      Runtime shows single-column form. Real design gap, not noise.

  # ── Shop Detail Flow ───────────────────────────────────

  - screen_id: shop_detail_overview_active
    flow_id: shop_detail
    step: 1
    variant: active
    route: /shops/{shopId}
    preconditions:
      auth: true
      data: "shop exists, status ACTIVE"
    setup:
      strategy: direct
      user_type: main
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='shop-name']"
        reason: "Dynamic shop name"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.93
    tags: [shop-detail, overview, mvp]
    notes: "Shop detail page, Overview tab. Shows Theme/Products/Colors/Fonts cards."
    unconfigured_reason: "No shop detail screens exist in Figma file — not yet designed"

  - screen_id: shop_detail_overview_needs_setup
    flow_id: shop_detail
    step: 1
    variant: needs_setup
    route: /shops/{shopId}
    preconditions:
      auth: true
      data: "shop exists, status DRAFT|ANALYZING|THEME_SELECTION|SETUP"
    setup:
      strategy: direct
      user_type: main
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='shop-name']"
        reason: "Dynamic shop name"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.93
    tags: [shop-detail, overview, needs-setup, mvp]
    notes: "Shop detail with 'Finish setting up' banner + Continue Setup button."
    unconfigured_reason: "No shop detail screens exist in Figma file — not yet designed"

  - screen_id: shop_detail_products_empty
    flow_id: shop_detail
    step: 2
    variant: empty
    route: /shops/{shopId}
    preconditions:
      auth: true
      data: "shop exists, zero products, Products tab active"
    setup:
      strategy: action_sequence
      user_type: main
      actions:
        - { action: click, selector: '[data-testid="tab-products"]' }
        - { action: wait, timeout: 500 }
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [shop-detail, products, empty-state, mvp]
    notes: >
      Products tab showing 'No products yet' with Add Product button.
      Uses draft shop (no products). Action: click Products tab.
    unconfigured_reason: "No shop detail screens exist in Figma file — not yet designed"

  - screen_id: shop_detail_products_populated
    flow_id: shop_detail
    step: 2
    variant: populated
    route: /shops/{shopId}
    preconditions:
      auth: true
      data: "shop exists, 1+ products, Products tab active"
    setup:
      strategy: action_sequence
      user_type: main
      actions:
        - { action: click, selector: '[data-testid="tab-products"]' }
        - { action: wait, timeout: 500 }
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks:
      - selector: "[data-testid='product-list']"
        reason: "Product titles/prices are dynamic seeded data"
    thresholds:
      pixel_diff_percent: 1.0
      structural_similarity: 0.92
    tags: [shop-detail, products, populated, mvp]
    notes: "Products tab showing product list items. Action: click Products tab."
    unconfigured_reason: "No shop detail screens exist in Figma file — not yet designed"

  # ── Settings ───────────────────────────────────────────

  - screen_id: settings_default
    flow_id: settings
    step: 1
    variant: default
    route: /settings
    preconditions:
      auth: true
    setup:
      strategy: direct
      user_type: main
    figma:
      file_key: "eSn1fOnDgiIQUbBBhrdrOs"
      node_id: "TODO_FIGMA_NODE_ID"
    viewport: { width: 1440, height: 1024 }
    masks: []
    thresholds:
      pixel_diff_percent: 0.5
      structural_similarity: 0.95
    tags: [settings, placeholder, excluded-mvp]
    notes: "Placeholder settings page with Sign Out button. Low priority for review."
    unconfigured_reason: "Settings page is not designed in Figma — placeholder only"
